rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Public read for event details and active ticket categories
    match /events/{eventId} {
      allow read: if true;
      allow write: if true; // Managed by admin or initial bootstrap
    }

    match /ticket_types/{ticketTypeId} {
      allow read: if true;
      allow write: if true;
    }

    match /programs/{programId} {
      allow read: if true;
      allow write: if true;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    match /promo_codes/{promoId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders collection: attendees create orders and confirm Wave payments
    match /orders/{orderId} {
      allow read: if true;
      allow create: if request.resource.data.order_number is string
                    && request.resource.data.quantity is number
                    && request.resource.data.total_amount is number;
      allow update: if true;
      allow delete: if false;
    }

    // Tickets collection: generated tickets, read by QR scanner and validated at gate
    match /tickets/{ticketId} {
      allow read: if true;
      allow create: if request.resource.data.ticket_number is string
                    && request.resource.data.qr_token is string;
      allow update: if true; // Entrance gate validation marks ticket as USED
      allow delete: if false;
    }

    // Check-in audit logs
    match /check_ins/{checkInId} {
      allow read: if true;
      allow create: if request.resource.data.ticket_number is string
                    && request.resource.data.operator is string;
      allow update, delete: if false;
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
